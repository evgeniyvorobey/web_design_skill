{
  "$description": "Minimal valid DTCG 2025.10 token file — the output adapter's target. Media type application/design-tokens+json. Demonstrates the modern object color/dimension shapes, aliases, the typography composite, and the $extensions vendor escape hatch.",
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": { "colorSpace": "srgb", "components": [0, 0.4, 0.8], "alpha": 1, "hex": "#0066cc" },
        "$description": "Primary brand color",
        "$extensions": { "com.figma": { "variableId": "VariableID:1:2", "scopes": ["FRAME_FILL", "TEXT_FILL"] } }
      }
    },
    "semantic": {
      "action": { "$value": "{color.brand.primary}" },
      "on-action": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1, "hex": "#ffffff" }
      }
    }
  },
  "dimension": {
    "$type": "dimension",
    "space": {
      "sm": { "$value": { "value": 8, "unit": "px" } },
      "md": { "$value": { "value": 16, "unit": "px" } },
      "lg": { "$value": { "value": 24, "unit": "px" } }
    },
    "radius": {
      "sm": { "$value": { "value": 0.25, "unit": "rem" } }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "typography": {
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": { "value": 2, "unit": "rem" },
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.2
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": { "value": 1, "unit": "rem" },
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.5
      }
    }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": { "value": 100, "unit": "ms" } },
    "moderate": { "$type": "duration", "$value": { "value": 240, "unit": "ms" } }
  },
  "easing": {
    "enter": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.15, "hex": "#000000" },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 2, "unit": "px" },
        "blur": { "value": 8, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    }
  }
}
